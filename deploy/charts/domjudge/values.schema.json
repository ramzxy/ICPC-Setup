{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "service": {
      "type": "object",
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort"]},
        "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767}
      }
    },
    "database": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"},
        "persistence": {
          "type": "object",
          "properties": {
            "storageClass": {"type": ["string", "null"]},
            "existingClaim": {"type": "string"},
            "size": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "domserver": {
      "type": "object",
      "properties": {
        "installDemoData": {"type": "boolean"},
        "fpmMaxChildren": {"type": "integer", "minimum": 1},
        "trustedProxies": {"type": "string"}
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "minLength": 1},
        "certResolver": {"type": "string"},
        "tlsSecretName": {"type": "string"},
        "redirectHttp": {"type": "boolean"}
      }
    },
    "judgehost": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "daemonId": {"type": "integer", "minimum": 0},
        "baseUrl": {"type": "string"},
        "nodeSelector": {"type": "object"}
      }
    }
  }
}
