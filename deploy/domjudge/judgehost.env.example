# Copy to judgehost.env on the judge VM and edit before starting.
# Use a URL reachable FROM that VM, with a trailing slash and WITHOUT /api/.
DOMSERVER_BASEURL=https://judge.example.invalid/
JUDGEDAEMON_USERNAME=judgehost
JUDGEDAEMON_PASSWORD=REPLACE_WITH_JUDGEHOST_ACCOUNT_PASSWORD
# The official image binds this daemon to the CPU with the same number.
# CPU 1 requires a VM with at least two vCPUs; verify available CPU IDs first.
DAEMON_ID=1
